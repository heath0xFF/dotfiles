# Dotfiles Brewfile
# Install with: brew bundle install
# Update with: brew bundle dump --force --file=~/code/dotfiles/Brewfile

# Taps
tap "maddada/tap"       # fluidvoice

# Core
brew "curl"
brew "gettext"
brew "git"

# Terminal & Shell
brew "tmux"

# Build tools (neovim from source, etc.)
brew "cmake"
brew "ninja"

# Search & Navigation
brew "ripgrep"

# Development
brew "gh"
brew "node"
brew "pyenv"
brew "xcodegen"

# AI / LLM
brew "llmfit"

# Media
brew "ffmpeg"

# System
brew "bpytop"
brew "fastfetch"
brew "macmon"

# Fonts (ghostty is configured for InconsolataMonoNerdFont)
cask "font-inconsolata-nerd-font"

# Casks
cask "cmux"           # primary terminal (Ghostty-based)
cask "ghostty"
cask "fluidvoice"
cask "localsend"

# npm CLIs
npm "firecrawl-cli"
